# Secrets and local configuration
.env
.env.*
!.env.example
.claude/settings.local.json
**/.claude/state/*.jsonl
**/.claude/state/session-*
.claude/scheduled_tasks.lock
.mcp.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Data / model artifacts
artifacts/
data/raw/
data/private/
# Rebuildable from the database by db.dataset_cache, keyed by a hash of
# the window, the feature flags and the rows it was built from -- a
# per-environment artifact, never source.
data/cache/
models/*.bin
models/*.pkl
models/*.joblib
catboost_info/

# Generated dashboard snapshot -- written by db.dashboard_report, not
# source; a per-environment artifact that changes every refresh cycle.
web/dashboard/snapshot/*.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build
build/
dist/
coverage/
htmlcov/
