# Application
APP_ENV=local
LOG_LEVEL=INFO

# Database: PostgreSQL is the default profile
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/app

# Claude Code model aliases/full IDs can be overridden locally.
CLAUDE_MECHANICAL_MODEL=haiku
CLAUDE_STANDARD_MODEL=sonnet
CLAUDE_ADVANCED_MODEL=opus

# Never commit actual keys.
ANTHROPIC_API_KEY=
